{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Wren",
  "scopeName": "source.wren",
  "fileTypes": [
    "wren"
  ],
  "patterns": [
    {
      "include": "#code"
    }
  ],
  "repository": {
    "code": {
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#attributes"
        },
        {
          "include": "#import"
        },
        {
          "include": "#class-decl"
        },
        {
          "include": "#method-decl"
        },
        {
          "include": "#strings"
        },
        {
          "include": "#numbers"
        },
        {
          "include": "#keywords"
        },
        {
          "include": "#constants"
        },
        {
          "include": "#fields"
        },
        {
          "include": "#class-names"
        },
        {
          "include": "#calls"
        },
        {
          "include": "#operators"
        },
        {
          "include": "#blocks"
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.line.shebang.wren",
          "match": "\\A#!.*$"
        },
        {
          "name": "comment.line.double-slash.wren",
          "match": "//.*$"
        },
        {
          "include": "#block-comment"
        }
      ]
    },
    "block-comment": {
      "name": "comment.block.wren",
      "begin": "/\\*",
      "end": "\\*/",
      "patterns": [
        {
          "include": "#block-comment"
        }
      ]
    },
    "attributes": {
      "name": "meta.attribute.wren",
      "match": "#!?\\s*[A-Za-z_][A-Za-z0-9_]*",
      "captures": {
        "0": {
          "name": "entity.other.attribute-name.wren"
        }
      }
    },
    "import": {
      "begin": "\\b(import)\\b",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.import.wren"
        }
      },
      "end": "$",
      "patterns": [
        {
          "include": "#strings"
        },
        {
          "match": "\\b(for|as)\\b",
          "name": "keyword.control.import.wren"
        },
        {
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b",
          "name": "entity.name.type.wren"
        },
        {
          "include": "#comments"
        }
      ]
    },
    "class-decl": {
      "match": "\\b(?:(foreign)\\s+)?(class)\\s+([A-Za-z_][A-Za-z0-9_]*)(?:\\s+(is)\\s+([A-Za-z_][A-Za-z0-9_]*))?",
      "captures": {
        "1": {
          "name": "storage.modifier.wren"
        },
        "2": {
          "name": "storage.type.class.wren"
        },
        "3": {
          "name": "entity.name.type.class.wren"
        },
        "4": {
          "name": "keyword.other.is.wren"
        },
        "5": {
          "name": "entity.other.inherited-class.wren"
        }
      }
    },
    "method-decl": {
      "comment": "Method/getter/setter/constructor definitions at the start of a line inside a class body.",
      "match": "^\\s*(?:(foreign)\\s+)?(?:(static)\\s+)?(?:(construct)\\s+)?([a-z_][A-Za-z0-9_]*)(?:(=)?(?=\\s*\\()|(?=\\s*\\{))",
      "captures": {
        "1": {
          "name": "storage.modifier.wren"
        },
        "2": {
          "name": "storage.modifier.wren"
        },
        "3": {
          "name": "storage.type.construct.wren"
        },
        "4": {
          "name": "entity.name.function.wren"
        },
        "5": {
          "name": "keyword.operator.assignment.wren"
        }
      }
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.triple.wren",
          "begin": "\"\"\"",
          "end": "\"\"\""
        },
        {
          "name": "string.quoted.double.wren",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "include": "#escapes"
            },
            {
              "include": "#interpolation"
            }
          ]
        }
      ]
    },
    "escapes": {
      "patterns": [
        {
          "name": "constant.character.escape.wren",
          "match": "\\\\(?:[0\"\\\\%abefnrtv]|x[0-9A-Fa-f]{2}|u[0-9A-Fa-f]{4}|U[0-9A-Fa-f]{8})"
        },
        {
          "name": "invalid.illegal.escape.wren",
          "match": "\\\\."
        }
      ]
    },
    "interpolation": {
      "name": "meta.interpolation.wren",
      "begin": "%\\(",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.interpolation.begin.wren"
        }
      },
      "end": "\\)",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.interpolation.end.wren"
        }
      },
      "contentName": "source.wren",
      "patterns": [
        {
          "include": "#parens"
        },
        {
          "include": "#code"
        }
      ]
    },
    "parens": {
      "begin": "\\(",
      "end": "\\)",
      "patterns": [
        {
          "include": "#parens"
        },
        {
          "include": "#code"
        }
      ]
    },
    "blocks": {
      "comment": "Block-argument parameter lists: { |a, b| ... }",
      "match": "(\\|)([A-Za-z_][A-Za-z0-9_,\\s]*)(\\|)",
      "captures": {
        "1": {
          "name": "punctuation.definition.parameters.wren"
        },
        "2": {
          "name": "variable.parameter.wren"
        },
        "3": {
          "name": "punctuation.definition.parameters.wren"
        }
      }
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.wren",
          "match": "\\b0x[0-9A-Fa-f]+\\b"
        },
        {
          "name": "constant.numeric.decimal.wren",
          "match": "\\b\\d+(?:\\.\\d+)?(?:[eE][+-]?\\d+)?\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.wren",
          "match": "\\b(break|continue|else|for|if|in|return|while)\\b"
        },
        {
          "name": "keyword.other.wren",
          "match": "\\b(as|is|import)\\b"
        },
        {
          "name": "storage.type.wren",
          "match": "\\b(var|class|construct)\\b"
        },
        {
          "name": "storage.modifier.wren",
          "match": "\\b(static|foreign)\\b"
        },
        {
          "name": "variable.language.wren",
          "match": "\\b(this|super)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.wren",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.null.wren",
          "match": "\\bnull\\b"
        }
      ]
    },
    "fields": {
      "patterns": [
        {
          "name": "variable.other.static-field.wren",
          "match": "\\b__[A-Za-z0-9_]+\\b"
        },
        {
          "name": "variable.other.field.wren",
          "match": "\\b_[A-Za-z0-9_]+\\b"
        }
      ]
    },
    "class-names": {
      "name": "entity.name.type.wren",
      "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
    },
    "calls": {
      "patterns": [
        {
          "match": "(?<=\\.)\\s*([a-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "entity.name.function.member.wren"
            }
          }
        },
        {
          "match": "\\b([a-z_][A-Za-z0-9_]*)(?=\\s*\\()",
          "captures": {
            "1": {
              "name": "entity.name.function.wren"
            }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.range.wren",
          "match": "\\.\\.\\.?"
        },
        {
          "name": "keyword.operator.bitwise.wren",
          "match": "<<|>>|&|\\||\\^|~"
        },
        {
          "name": "keyword.operator.logical.wren",
          "match": "&&|\\|\\||!(?!=)"
        },
        {
          "name": "keyword.operator.comparison.wren",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.assignment.wren",
          "match": "="
        },
        {
          "name": "keyword.operator.arithmetic.wren",
          "match": "[-+*/%]"
        },
        {
          "name": "keyword.operator.ternary.wren",
          "match": "[?:]"
        }
      ]
    }
  }
}